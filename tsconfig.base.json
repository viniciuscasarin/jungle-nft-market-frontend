{
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "importHelpers": false,
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nft/shared-contracts": ["libs/shared/contracts/src/index.ts"],
      "@nft/shared-money": ["libs/shared/money/src/index.ts"],
      "@nft/shared-http": ["libs/shared/http/src/index.ts"],
      "@nft/shared-query": ["libs/shared/query/src/index.ts"],
      "@nft/shared-router": ["libs/shared/router/src/index.ts"],
      "@nft/shared-realtime": ["libs/shared/realtime/src/index.ts"],
      "@nft/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@nft/shared-testing": ["libs/shared/testing/src/index.ts"],
      "@nft/shell-kit": ["libs/shell-kit/src/index.ts"],
      "@nft/mocks-core": ["libs/mocks/core/src/index.ts"],
      "@nft/mocks-fixtures": ["libs/mocks/fixtures/src/index.ts"],
      "@nft/mocks-handlers": ["libs/mocks/handlers/src/index.ts"],
      "@nft/mocks-socket": ["libs/mocks/socket/src/index.ts"],
      "@nft/auth-domain": ["libs/auth/domain/src/index.ts"],
      "@nft/auth-data-access": ["libs/auth/data-access/src/index.ts"],
      "@nft/auth-feature": ["libs/auth/feature/src/index.ts"],
      "@nft/auth-ui": ["libs/auth/ui/src/index.ts"],
      "@nft/catalog-domain": ["libs/catalog/domain/src/index.ts"],
      "@nft/catalog-data-access": ["libs/catalog/data-access/src/index.ts"],
      "@nft/catalog-feature": ["libs/catalog/feature/src/index.ts"],
      "@nft/catalog-ui": ["libs/catalog/ui/src/index.ts"],
      "@nft/favorites-domain": ["libs/favorites/domain/src/index.ts"],
      "@nft/favorites-data-access": ["libs/favorites/data-access/src/index.ts"],
      "@nft/favorites-feature": ["libs/favorites/feature/src/index.ts"],
      "@nft/favorites-ui": ["libs/favorites/ui/src/index.ts"],
      "@nft/cart-domain": ["libs/cart/domain/src/index.ts"],
      "@nft/cart-data-access": ["libs/cart/data-access/src/index.ts"],
      "@nft/cart-feature": ["libs/cart/feature/src/index.ts"],
      "@nft/cart-ui": ["libs/cart/ui/src/index.ts"],
      "@nft/checkout-domain": ["libs/checkout/domain/src/index.ts"],
      "@nft/checkout-data-access": ["libs/checkout/data-access/src/index.ts"],
      "@nft/checkout-feature": ["libs/checkout/feature/src/index.ts"],
      "@nft/checkout-ui": ["libs/checkout/ui/src/index.ts"],
      "@nft/orders-domain": ["libs/orders/domain/src/index.ts"],
      "@nft/orders-data-access": ["libs/orders/data-access/src/index.ts"],
      "@nft/orders-feature": ["libs/orders/feature/src/index.ts"],
      "@nft/orders-ui": ["libs/orders/ui/src/index.ts"],
      "@nft/profile-domain": ["libs/profile/domain/src/index.ts"],
      "@nft/profile-data-access": ["libs/profile/data-access/src/index.ts"],
      "@nft/profile-feature": ["libs/profile/feature/src/index.ts"],
      "@nft/profile-ui": ["libs/profile/ui/src/index.ts"],
      "@nft/wallets-domain": ["libs/wallets/domain/src/index.ts"],
      "@nft/wallets-data-access": ["libs/wallets/data-access/src/index.ts"],
      "@nft/wallets-feature": ["libs/wallets/feature/src/index.ts"],
      "@nft/wallets-ui": ["libs/wallets/ui/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
